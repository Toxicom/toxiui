# Copy to .env (gitignored) and paste values in as you go through the setup.
# Used locally by: node --env-file=.env scripts/register-commands.mjs
# Keep a copy of the two secrets (bot token, export token) in a password manager too.

# Discord Developer Portal -> General Information
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=

# Discord Developer Portal -> Bot -> Reset Token (SECRET, shown only once)
DISCORD_BOT_TOKEN=

# Discord app, Developer Mode on -> right-click server -> Copy Server ID
GUILD_ID=

# Discord app -> Server Settings -> Roles -> right-click role -> Copy Role ID
ROLE_LEGENDARY=
ROLE_EPIC=
ROLE_RARE=

# SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXPORT_TOKEN=

{
  "workspace.library": [
    "~/.vscode/extensions/ketho.wow-api-0.22.3/Annotations/Core",
    "~/.vscode/extensions/ketho.wow-api-0.22.3/Annotations/FrameXML"
  ],
  "workspace.ignoreDir": [
    ".vscode",
    "Assets/*",
    "Media/*",
    "Core/Changelog/*"
  ],
  "workspace.preloadFileSize": 5000,
  "runtime.version": "Lua 5.1",
  "runtime.builtin": {
    "basic": "disable",
    "debug": "disable",
    "io": "disable",
    "math": "disable",
    "os": "disable",
    "package": "disable",
    "string": "disable",
    "table": "disable",
    "utf8": "disable"
  },
  "diagnostics.enable": true,
  "diagnostics.globals": [
    "_G",
    "bit",

    "string.utf8len",
    "string.utf8lower",
    "string.utf8sub",
    "string.utf8upper",

    "BigWigs",
    "Details",
    "ElvUI",
    "LibStub",
    "DamageMeter",

    "BigWigsAPI",
    "DBT_AllPersistentOptions",
    "ElvDB"
  ],
  "diagnostics.disable": [
    "inject-field",
    "undefined-field"
  ],
  "diagnostics.ignoredFiles": "Disable",
  "diagnostics.libraryFiles": "Disable",
  "format.enable": false
}
